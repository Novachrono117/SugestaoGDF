# Copie para .env e preencha. Nunca versione o .env.

# Banco: PostgreSQL do docker-compose.yml (suba com `docker compose up -d`).
# Credenciais locais do container — troque a senha; em produção use o banco gerenciado.
POSTGRES_USER="vozdf"
POSTGRES_PASSWORD="troque-esta-senha"
POSTGRES_DB="vozdf"
# Porta no seu computador. Se a 5432 já estiver ocupada (outro Postgres), use 5433 aqui E na DATABASE_URL.
POSTGRES_PORTA="5432"
DATABASE_URL="postgresql://vozdf:troque-esta-senha@localhost:5432/vozdf?schema=public"

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""

# URL pública do app (usada no callbackUrl e nas URLs de anexos enviadas ao GDF)
APP_URL="http://localhost:3000"

# Uploads (fora de src/, nunca versionados)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5

# IA local (Ollama). Sem Ollama rodando, o app usa o classificador por regras.
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3.5:4b"
CLASSIFICADOR_TIMEOUT_MS=8000

# Integração com o GDF — no MVP aponta para o Simulador GDF do próprio app.
GDF_WEBHOOK_URL="http://localhost:3000/api/simulador-gdf/manifestacoes"
# Chave que o Voz DF envia ao GDF (push) e chave que o GDF envia ao Voz DF (callback).
# Gere valores longos e aleatórios, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GDF_WEBHOOK_KEY=""
GDF_CALLBACK_KEY=""

# Senha dos usuários fictícios criados pelo seed (somente desenvolvimento). SEED_USUARIOS_DEMO=false não os cria.
SEED_USUARIOS_DEMO=true
SEED_SENHA_DEMO=""

# E-mail (SMTP). No desenvolvimento: Mailpit do docker compose (veja em http://localhost:8025).
# Sem SMTP_HOST, os e-mails ficam na fila e nada é enviado.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SEGURO=false
SMTP_USUARIO=""
SMTP_SENHA=""
EMAIL_REMETENTE="Voz DF <nao-responda@vozdf.example>"

# LGPD: e-mail de contato para pedidos do titular, mostrado em /privacidade (vazio = texto genérico)
CONTATO_PRIVACIDADE=""
