# Variáveis do deploy com compose.producao.yml. Copie para .env.producao (nunca versione) e preencha.
# Gere segredos com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (use hex: caracteres especiais quebram a DATABASE_URL montada pelo compose)

# Domínio público apontando (DNS tipo A) para o servidor. O Caddy emite o certificado HTTPS sozinho.
# Para testar na própria máquina: DOMINIO=localhost (certificado local; o callback do simulador não funciona).
DOMINIO="vozdf.exemplo.com.br"

# Banco (container interno, sem porta exposta)
POSTGRES_USER="vozdf"
POSTGRES_PASSWORD=""
POSTGRES_DB="vozdf"

# Auth.js (npx auth secret ou o comando acima)
AUTH_SECRET=""

# Integração com o GDF. Sem GDF_WEBHOOK_URL, usa o Simulador GDF do próprio app.
# GDF_WEBHOOK_URL="https://api.gdf.exemplo/manifestacoes"
GDF_WEBHOOK_KEY=""
GDF_CALLBACK_KEY=""

# Usuários fictícios do seed (operador do simulador + cidadã). Senha forte: o site fica público.
SEED_SENHA_DEMO=""

# IA: vazio = classificador por regras (hospedagem sem GPU). Com Ollama em outra máquina/VM:
# OLLAMA_URL="http://ip-da-vm:11434"
# OLLAMA_MODEL="qwen3.5:4b"
OLLAMA_MODEL=""

# E-mail: provedor SMTP real (ex.: Brevo, Mailgun, SES). Vazio = e-mails ficam na fila, nada é enviado.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SEGURO=false
SMTP_USUARIO=""
SMTP_SENHA=""
EMAIL_REMETENTE="Voz DF <nao-responda@vozdf.exemplo.com.br>"
